# Prefer `node scripts/setup.mjs` to generate a unique password and .env file.
NODE_ENV=production
APP_ORIGIN=https://esport.uika-bogor.ac.id
ALLOWED_ORIGINS=https://esport.uika-bogor.ac.id,https://pdf.uika-bogor.ac.id
PUBLIC_HOST=esport.uika-bogor.ac.id
PORT=3000
PUBLIC_PORT=5050
BIND_ADDRESS=127.0.0.1
POSTGRES_USER=uvelocity
POSTGRES_DB=uvelocity
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_PASSWORD
DATABASE_URL=postgresql://uvelocity:REPLACE_WITH_A_UNIQUE_RANDOM_PASSWORD@127.0.0.1:5432/uvelocity
COOKIE_SECURE=true
TRUST_PROXY=1
VITE_BASE_PATH=/uvelocity/
