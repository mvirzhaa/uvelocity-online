{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist/server",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "server",
    "shared",
    "scripts"
  ],
  "exclude": [
    "client",
    "tests",
    "node_modules"
  ]
}
