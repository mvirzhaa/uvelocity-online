{
  "name": "uvelocity",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "description": "UVelocity — multiplayer 3D racing with PostgreSQL accounts, virtual Rupiah, garage and administration.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --import tsx server/dev.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "admin:create": "node --import tsx scripts/admin-create.ts",
    "setup": "node scripts/setup.mjs",
    "test": "node --import tsx --test tests/race/*.test.ts",
    "test:integration": "node tests/with-postgres.mjs tests/integration.ts",
    "test:backend": "node tests/with-postgres.mjs --test server/services/__tests__/*.integration.test.ts",
    "test:renderer": "node tests/renderer/verify.cjs",
    "test:dev": "node tests/with-postgres.mjs tests/dev-runtime.ts",
    "test:ui": "node tests/workshop-ui.mjs",
    "test:prayer-ui": "node tests/prayer-ui.mjs",
    "test:media-ui": "node tests/media-ui.mjs",
    "test:vehicle-images-ui": "node tests/vehicle-images-ui.mjs",
    "test:vehicle-categories-ui": "node tests/vehicle-categories-ui.mjs"
  },
  "dependencies": {
    "@colyseus/core": "0.18.29",
    "@colyseus/sdk": "0.18.10",
    "@colyseus/ws-transport": "0.18.5",
    "adhan": "4.4.6",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "geo-tz": "8.1.11",
    "helmet": "^8.1.0",
    "pg": "8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.4",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "embedded-postgres": "18.7.0-beta.19",
    "esbuild": "0.28.2",
    "linkedom": "^0.18.15",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.6"
  }
}
